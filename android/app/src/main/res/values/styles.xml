<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Material 3 theme applied to the Android Window while the process is starting -->
    <style name="LaunchTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Support for edge-to-edge on modern Android -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Modern Material 3 theme applied as soon as the Flutter UI initializes -->
    <style name="NormalTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
